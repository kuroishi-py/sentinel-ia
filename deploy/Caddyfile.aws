# Borde TLS de SENTINEL-IA en AWS (EC2).
#
# Igual que deploy/Caddyfile (TLS 1.3, HSTS, /metrics y /v1/stats cerrados,
# log JSON sin la API key), con dos diferencias:
#
# 1. Certificados publicos de Let's Encrypt en vez de la CA local, para que el
#    docente abra las URLs sin advertencias. Sin dominio propio se usa
#    sslip.io, que resuelve cualquier nombre que contenga la IP:
#        API_HOST=api.54-232-10-20.sslip.io
#        DASHBOARD_HOST=dashboard.54-232-10-20.sslip.io
#    Let's Encrypt valida por el puerto 80, que debe estar abierto.
# 2. La consola de Fraud Ops queda en Internet, asi que pide usuario y
#    contrasena (hash bcrypt en DASHBOARD_PASSWORD_HASH).
#
# Lo monta deploy/docker-compose.aws.yml. Las variables vienen de .env.

(seguridad) {
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        -Server
    }
}

# API de scoring
{$API_HOST} {
    tls {
        protocols tls1.3
    }

    # Operacion: solo por la red interna (EP2 8.2: "el resto responde 404").
    @operacion path /metrics /v1/stats
    respond @operacion 404

    reverse_proxy api:8000

    # Log de acceso en JSON: va a CloudWatch Logs (/sentinel-ia/proxy). La API
    # key se borra antes de escribir (EP2 8.3).
    log {
        output stdout
        format filter {
            wrap json
            fields {
                request>headers>X-Api-Key delete
            }
        }
    }

    import seguridad
}

# Consola de Fraud Ops
{$DASHBOARD_HOST} {
    tls {
        protocols tls1.3
    }
    basic_auth {
        {$DASHBOARD_USER} {$DASHBOARD_PASSWORD_HASH}
    }
    reverse_proxy dashboard:8501
    import seguridad
}
