# Copia este archivo a .env y ajusta. .env esta en .gitignore: nunca se sube.
# Ningun secreto va en el codigo ni en la imagen (EP2 seccion 8.2).
# docker compose lee .env solo; para correr la API sin Docker, exporta las
# variables en la terminal.

# --- Autenticacion ----------------------------------------------------------
# Claves de los clientes de /v1/score, "cliente:clave" separados por coma. En
# AWS la reemplaza el certificado mTLS de la pasarela en el ALB.
API_KEYS=pasarela:cambia-esta-clave
# La clave con que el dashboard, Locust y k6 llaman a la API. Debe ser una de
# las de API_KEYS.
SENTINEL_API_KEY=cambia-esta-clave
AUTH_ENABLED=true
# Solo si hay un proxy propio delante (Caddy, ALB). Expuesta directo, la API no
# debe confiar en X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# --- Modelo -------------------------------------------------------------------
# local     = el modelo vive en memoria dentro de la API (decision D2 de la EP2)
# sagemaker = el modelo vive en un endpoint de SageMaker (pauta de la EP3)
SCORER_BACKEND=local
MODEL_PATH=artifacts/model.json
MODEL_VERSION=dev-0
# Por omision, merchant_risk.json junto al modelo.
MERCHANT_RISK_PATH=

# Solo con SCORER_BACKEND=sagemaker
SAGEMAKER_ENDPOINT=
AWS_REGION=sa-east-1

# --- Feature store y bus ----------------------------------------------------------
# auto: Redis si responde al arrancar, si no memoria del proceso.
# redis: siempre Redis (si cae, las decisiones salen degradadas).
# memory: memoria del proceso, para desarrollo sin Docker.
FEATURE_STORE=auto
REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT_MS=50
AMQP_URL=amqp://guest:guest@localhost:5672/
DECISION_EXCHANGE=decision.v1
PUBLISHER_ENABLED=true

# --- Presupuesto de latencia -------------------------------------------------------
# La pasarela corta a 80 ms; el servicio corta a 60 ms y responde degradado.
INTERNAL_BUDGET_MS=60

# --- Politica -------------------------------------------------------------------------
THRESHOLD_REVIEW=0.45
THRESHOLD_REJECT=0.80
AMOUNT_REVIEW_FLOOR=2000000

# --- Rate limiting --------------------------------------------------------------------
# Por cliente autenticado y por proceso: con 2 workers el tope efectivo de la
# tarea es el doble. En AWS el limite de borde va en el ALB o en WAF.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=200
RATE_LIMIT_BURST=400

# --- Docker en Linux ----------------------------------------------------------------------
# Para que el worker escriba data/cases.jsonl con tu usuario: SENTINEL_UID=$(id -u)
# SENTINEL_UID=1000
