# Copia este archivo a .env y ajusta. .env esta en .gitignore: nunca se sube.
# Ningun secreto va en el codigo ni en la imagen (EP2 seccion 8.2).

# --- Modelo ---------------------------------------------------------------
# local     = el modelo vive en memoria dentro de la API (decision D2 de la EP2)
# sagemaker = el modelo vive en un endpoint de SageMaker (pauta de la EP3)
SCORER_BACKEND=local
MODEL_PATH=artifacts/model.json
MODEL_VERSION=dev-0

# Solo con SCORER_BACKEND=sagemaker
SAGEMAKER_ENDPOINT=
AWS_REGION=sa-east-1

# --- Infraestructura ------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
AMQP_URL=amqp://guest:guest@localhost:5672/
DECISION_EXCHANGE=decision.v1
PUBLISHER_ENABLED=true

# --- Presupuesto de latencia ---------------------------------------------
# La pasarela corta a 80 ms; el servicio corta a 60 ms y responde degradado.
INTERNAL_BUDGET_MS=60

# --- Politica -------------------------------------------------------------
THRESHOLD_REVIEW=0.45
THRESHOLD_REJECT=0.80
AMOUNT_REVIEW_FLOOR=2000000

# --- Rate limiting --------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=200
RATE_LIMIT_BURST=400
